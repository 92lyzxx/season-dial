{
  "name": "season-dial",
  "productName": "SeasonDial",
  "version": "1.0.0",
  "description": "A four-season desktop clock pet for Windows: an oval seasonal island whose golden needle sweeps spring green into summer teal, autumn amber and winter snow while showing the real time.",
  "main": "main.js",
  "author": "溪行 (Xixing)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/USERNAME/season-dial.git"
  },
  "homepage": "https://github.com/USERNAME/season-dial#readme",
  "bugs": {
    "url": "https://github.com/USERNAME/season-dial/issues"
  },
  "keywords": [
    "desktop-pet",
    "desktop-widget",
    "electron",
    "clock",
    "four-seasons",
    "windows",
    "canvas"
  ],
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable --x64",
    "icon": "python tools/make_icon.py"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.xixing.seasondial",
    "productName": "SeasonDial",
    "portable": {
      "artifactName": "SeasonDial-${version}.exe"
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "assets/icon.png",
      "!assets/icon_src.png"
    ],
    "compression": "maximum"
  }
}
